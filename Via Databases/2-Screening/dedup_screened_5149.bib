  number={19},
  author={Prajapati P and Kane S and McBrinn RC and Dean MS and Martins da Silva SJ and Brown SG},
  institution={Reproductive Medicine Research Group, School of Medicine, Ninewells Hospital and Medical School, University of Dundee, Dundee DD1 9SY, UK.; School of Applied Sciences, Abertay University, Dundee DD1 1HG, UK.; School of Applied Sciences, Abertay University, Dundee DD1 1HG, UK.; Reproductive Medicine Research Group, School of Medicine, Ninewells Hospital and Medical School, University of Dundee, Dundee DD1 9SY, UK.; Assisted Conception Unit, Ninewells Hospital, Dundee DD1 9SY, UK.; Reproductive Medicine Research Group, School of Medicine, Ninewells Hospital and Medical School, University of Dundee, Dundee DD1 9SY, UK.; Assisted Conception Unit, Ninewells Hospital, Dundee DD1 9SY, UK.; School of Applied Sciences, Abertay University, Dundee DD1 1HG, UK.},
