  author={Suwimonteerabutr J and Yamsrikaew U and Damthongsen K and Suksirisamphan T and Leeniwa P and Lawanyakul P and Nuntapaitoon M},
  institution={Department of Obstetrics, Gynecology and Reproduction, Faculty of Veterinary Science, Chulalongkorn University, Bangkok 10330, Thailand.; 6th Year Veterinary Student, Faculty of Veterinary Science, Chulalongkorn University, Bangkok 10330, Thailand.; 6th Year Veterinary Student, Faculty of Veterinary Science, Chulalongkorn University, Bangkok 10330, Thailand.; 6th Year Veterinary Student, Faculty of Veterinary Science, Chulalongkorn University, Bangkok 10330, Thailand.; 6th Year Veterinary Student, Faculty of Veterinary Science, Chulalongkorn University, Bangkok 10330, Thailand.; 6th Year Veterinary Student, Faculty of Veterinary Science, Chulalongkorn University, Bangkok 10330, Thailand.; Department of Obstetrics, Gynecology and Reproduction, Faculty of Veterinary Science, Chulalongkorn University, Bangkok 10330, Thailand. Electronic address: Morakot.n@chula.ac.th.},
