  pages={28-34},
  author={Jameel M and Sheikh IS and Kakar N and Yousuf MR and Riaz A and Shehzad W and Khan D and Iqbal M and Tareen AM},
  institution={Department of Theriogenology, University of Veterinary and Animal Sciences, Pakistan.; Center for Advanced Studies in Vaccinology and Biotechnology, University of Balochistan, Pakistan.; Department of Natural and Basic Sciences, University of Turbat, Pakistan.; Department of Theriogenology, University of Veterinary and Animal Sciences, Pakistan.; Department of Theriogenology, University of Veterinary and Animal Sciences, Pakistan.; Institute of Biochemistry and Biotechnology, University of Veterinary and Animal Sciences, Pakistan.; Livestock and Dairy Development Department, Government of Balochistan, Pakistan.; Semen Production Unit, Livestock and Dairy Development Department, Government of Balochistan, Pakistan.; Department of Microbiology, University of Baluchistan, Quetta Pakistan.},
