  number={5},
  author={Alegre L and Carrión-Sisternas L and Bori L and Hervás I and Remohí J and Garrido N and Meseguer M},
  institution={IVIRMA Global Research Alliance, IVIRMA Valencia, Plaza de la Policía Local 3, 46015 Valencia, Spain.; IVIRMA Global Research Alliance, IVI Foundation, Instituto de Investigación Sanitaria La Fe (IIS La Fe), 46026 Valencia, Spain.; IVIRMA Global Research Alliance, IVI Foundation, Instituto de Investigación Sanitaria La Fe (IIS La Fe), 46026 Valencia, Spain.; IVIRMA Global Research Alliance, IVI Foundation, Instituto de Investigación Sanitaria La Fe (IIS La Fe), 46026 Valencia, Spain.; IVIRMA Global Research Alliance, IVIRMA Valencia, Plaza de la Policía Local 3, 46015 Valencia, Spain.; IVIRMA Global Research Alliance, IVI Foundation, Instituto de Investigación Sanitaria La Fe (IIS La Fe), 46026 Valencia, Spain.; IVIRMA Global Research Alliance, IVIRMA Valencia, Plaza de la Policía Local 3, 46015 Valencia, Spain.; IVIRMA Global Research Alliance, IVI Foundation, Instituto de Investigación Sanitaria La Fe (IIS La Fe), 46026 Valencia, Spain.},
